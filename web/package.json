{
  "name": "aperture-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:api && vitest run",
    "lint": "eslint src browser playwright*.config.ts && prettier --check src browser index.html vite.config.ts playwright*.config.ts tsconfig.json package.json scripts",
    "format": "prettier --write src browser index.html vite.config.ts playwright*.config.ts tsconfig.json package.json scripts",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api.generated.ts && prettier --write src/api.generated.ts",
    "check:api": "node scripts/check-api.mjs",
    "test:browser": "playwright test",
    "test:research": "playwright test --config playwright.research.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
